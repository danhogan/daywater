diff --git a/tests/test_c_cfg.c b/tests/test_c_cfg.c
index 9999080..029c2cb 100644
--- a/tests/test_c_cfg.c
+++ b/tests/test_c_cfg.c
@@ -102,10 +102,34 @@ static void test_memory_loop(void) {
     c_function_cfg_destroy(&cfg);
 }
 
+static void test_cache_loop(void) {
+    static const u32 words[] = {
+        0x7C0018ACu, /* dcbf 0,r3 */
+        0x38630020u, /* addi r3,r3,32 */
+        0x4BFFFFF8u, /* b BASE */
+        0x4E800020u, /* blr */
+    };
+    PPCInst insts[sizeof(words) / sizeof(words[0])];
+    for (u32 i = 0; i < sizeof(words) / sizeof(words[0]); ++i)
+        insts[i] = ppc_decode(words[i], BASE + i * 4u);
+
+    CFunctionCFG cfg;
+    check(c_function_cfg_build(&cfg, insts, 4, BASE), "build cache loop CFG");
+    check(insts[0].op == PPC_OP_DCBF && cfg.leaders[1],
+          "cache op ends its cycle-charge block");
+    check(cfg.block_cycles[0] == 5 && cfg.block_cycles[1] == 2,
+          "early cache return cannot charge following instructions");
+    check(cfg.materialize_pc[0], "cache callback sees its guest PC");
+    check(c_function_cfg_can_loop_directly(&cfg, insts, BASE, 2),
+          "cache loop can stay in generated code");
+    c_function_cfg_destroy(&cfg);
+}
+
 int main(void) {
     test_integer_loop();
     test_timebase_loop();
     test_local_call();
     test_memory_loop();
+    test_cache_loop();
     return failures != 0;
 }
